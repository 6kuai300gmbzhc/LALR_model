theory LALR_Test
  imports LALR_Termination LALR_Stack LALR_Rank_Auto LALR_Termination_Schema
begin

text \<open>
  The running example: an arithmetic-expression grammar and a hand-written
  ten-state LALR table for it.  The reduction rank and termination
  certificate are proved concretely below.
\<close>

definition p0 :: production where
  "p0 = \<lparr>number = 0, lhs = ''S'', rhs = [Nonterminal ''Eprime'']\<rparr>"

definition p1 :: production where
  "p1 = \<lparr>number = 1, lhs = ''Eprime'', rhs = [Nonterminal ''E'']\<rparr>"

definition p2 :: production where
  "p2 = \<lparr>number = 2, lhs = ''E'', rhs = [Nonterminal ''E'', Terminal ''PLUS'', Nonterminal ''T'']\<rparr>"

definition p3 :: production where
  "p3 = \<lparr>number = 3, lhs = ''E'', rhs = [Nonterminal ''T'']\<rparr>"

definition p4 :: production where
  "p4 = \<lparr>number = 4, lhs = ''T'', rhs = [Terminal ''LPAREN'', Nonterminal ''E'', Terminal ''RPAREN'']\<rparr>"

definition p5 :: production where
  "p5 = \<lparr>number = 5, lhs = ''T'', rhs = [Terminal ''A'']\<rparr>"

definition test_cfg :: "symbol cfg" where
  "test_cfg = CFG [
    (''Eprime'', [Nonterminal ''E'']),
    (''E'', [Nonterminal ''E'', Terminal ''PLUS'', Nonterminal ''T'']),
    (''E'', [Nonterminal ''T'']),
    (''T'', [Terminal ''LPAREN'', Nonterminal ''E'', Terminal ''RPAREN'']),
    (''T'', [Terminal ''A''])] ''Eprime''"

definition test_productions :: "production_id \<Rightarrow> production option" where
  "test_productions n = map_of [(0, p0), (1, p1), (2, p2), (3, p3), (4, p4), (5, p5)] n"

definition test_action :: "state \<Rightarrow> token \<Rightarrow> action option" where
  "test_action s tok = map_of [((0, ''A''), ActShift 5), ((0, ''LPAREN''), ActShift 4),
    ((1, ''END''), ActAccept), ((2, ''END''), ActReduce 1), ((2, ''PLUS''), ActShift 6),
    ((3, ''PLUS''), ActReduce 3), ((3, ''END''), ActReduce 3), ((3, ''RPAREN''), ActReduce 3),
    ((4, ''A''), ActShift 5), ((4, ''LPAREN''), ActShift 4),
    ((5, ''PLUS''), ActReduce 5), ((5, ''END''), ActReduce 5), ((5, ''RPAREN''), ActReduce 5),
    ((6, ''A''), ActShift 5), ((6, ''LPAREN''), ActShift 4),
    ((7, ''RPAREN''), ActShift 9), ((7, ''PLUS''), ActShift 6),
    ((8, ''PLUS''), ActReduce 2), ((8, ''END''), ActReduce 2), ((8, ''RPAREN''), ActReduce 2),
    ((9, ''PLUS''), ActReduce 4), ((9, ''END''), ActReduce 4), ((9, ''RPAREN''), ActReduce 4)] (s, tok)"

definition test_goto :: "state \<Rightarrow> nonterminal_ \<Rightarrow> state option" where
  "test_goto s nt = map_of [((0, ''Eprime''), 1), ((0, ''E''), 2), ((0, ''T''), 3),
    ((4, ''E''), 7), ((4, ''T''), 3), ((6, ''T''), 8)] (s, nt)"

definition test_table :: lalr_table where
  "test_table =
    \<lparr>parsing_method = ''LALR'',
      terminals = {''A'', ''LPAREN'', ''PLUS'', ''RPAREN'', end_token},
      nonterminals = {''S'', ''Eprime'', ''E'', ''T''},
      states = {0..9},
      productions = test_productions,
      actions = test_action,
      gotos = test_goto,
      start_state = 0\<rparr>"

definition test_reduce_graph :: "(state \<times> state) set" where
  "test_reduce_graph = reduce_graph test_table"

text \<open>
  The table-generation certificate is deliberately absent here: it is not
  used by the termination argument, and the earlier parameter choice
  @{text "bound = 0"} / @{text "initial_items = {}"} made the item-set
  certificate unsatisfiable, because the empty item set propagates from
  state 0 to state 3 while the Reduce clause demands the complete item
  @{text "(3, 1)"} there.  It should be re-instantiated with
  @{text "initial_items = {(0, 0)}"} and a bound of at least the closure
  depth (4 for this grammar).
\<close>

text \<open>
  The rank is no longer hand-written and no longer derived through a
  @{const wfrec} recursion on the graph: it is generated by evaluating the
  primitive-recursive iteration on an explicit list of reduction edges
  (@{const auto_reduce_rank}), and the certificate is the decidable check
  @{const reduce_rank_check} of that generated function.  Only the inclusion
  @{prop "reduce_graph test_table \<subseteq> set test_reduce_edges"} connects the
  list to the table; it is proved once below.  The numerical order
  @{term "{(s, g). g < s}"} cannot witness acyclicity here, because the graph
  contains the edges \<open>3 \<rightarrow> 7\<close> and \<open>5 \<rightarrow> 8\<close>, which
  point at numerically larger states.
\<close>

definition test_reduce_edges :: "(state \<times> state) list" where
  "test_reduce_edges =
    [(2, 1), (3, 2), (3, 7), (5, 3), (5, 8), (8, 2), (8, 7), (9, 3), (9, 8)]"

definition test_reduce_rank :: "state \<Rightarrow> nat" where
  "test_reduce_rank = auto_reduce_rank test_reduce_edges"

text \<open>Reading the reduce graph off the concrete table: the reducing states
  are classified first, then the successor set of each of them is computed.
  A concrete state keeps the map lookup finite.\<close>

lemma test_reduce_actions:
  "actions test_table s tok = Some (ActReduce rid) \<Longrightarrow>
   (s = 2 \<and> rid = 1) \<or> (s = 3 \<and> rid = 3) \<or> (s = 5 \<and> rid = 5) \<or>
   (s = 8 \<and> rid = 2) \<or> (s = 9 \<and> rid = 4)"
  by (auto simp: test_table_def test_action_def split: if_splits prod.splits)

text \<open>The productions of the table, one equation per identifier.\<close>

lemma test_productions_1: "productions test_table 1 = Some p1"
  by (simp add: test_table_def test_productions_def)

lemma test_productions_2: "productions test_table 2 = Some p2"
  by (simp add: test_table_def test_productions_def)

lemma test_productions_3: "productions test_table 3 = Some p3"
  by (simp add: test_table_def test_productions_def)

lemma test_productions_4: "productions test_table 4 = Some p4"
  by (simp add: test_table_def test_productions_def)

lemma test_productions_5: "productions test_table 5 = Some p5"
  by (simp add: test_table_def test_productions_def)

lemma test_lhs_p0 [simp]: "lhs p0 = ''S''"
  by (simp add: p0_def)

lemma test_lhs_p1 [simp]: "lhs p1 = ''Eprime''"
  by (simp add: p1_def)

lemma test_lhs_p2 [simp]: "lhs p2 = ''E''"
  by (simp add: p2_def)

lemma test_lhs_p3 [simp]: "lhs p3 = ''E''"
  by (simp add: p3_def)

lemma test_lhs_p4 [simp]: "lhs p4 = ''T''"
  by (simp add: p4_def)

lemma test_lhs_p5 [simp]: "lhs p5 = ''T''"
  by (simp add: p5_def)

text \<open>The target of a goto is fixed by the nonterminal alone: the goto
  table has only one entry per nonterminal, so no state information is
  needed.\<close>

lemma test_goto_Eprime: "gotos test_table s' ''Eprime'' = Some g \<Longrightarrow> g = 1"
  by (auto simp: test_table_def test_goto_def split: if_splits)

lemma test_goto_E: "gotos test_table s' ''E'' = Some g \<Longrightarrow> g = 2 \<or> g = 7"
  by (auto simp: test_table_def test_goto_def split: if_splits)

lemma test_goto_T: "gotos test_table s' ''T'' = Some g \<Longrightarrow> g = 3 \<or> g = 8"
  by (auto simp: test_table_def test_goto_def split: if_splits)

text \<open>
  The edge list covers the reduction graph.  The reducing states are
  classified by @{thm test_reduce_actions}, and in each case the production
  determines the left-hand side, hence the goto target.
\<close>

lemma test_reduce_graph_subset:
  "reduce_graph test_table \<subseteq> set test_reduce_edges"
proof
  fix x
  assume mem: "x \<in> reduce_graph test_table"
  obtain s g where x_pair: "x = (s, g)"
    and edge: "(s, g) \<in> reduce_graph test_table"
    using mem by (cases x) blast
  from edge obtain tok rid p s' where
      act: "actions test_table s tok = Some (ActReduce rid)"
    and prod: "productions test_table rid = Some p"
    and st: "s' \<in> states test_table"
    and gt: "gotos test_table s' (lhs p) = Some g"
    unfolding reduce_graph_def by blast
  from test_reduce_actions[OF act] have s_rid:
    "(s = 2 \<and> rid = 1) \<or> (s = 3 \<and> rid = 3) \<or> (s = 5 \<and> rid = 5) \<or>
     (s = 8 \<and> rid = 2) \<or> (s = 9 \<and> rid = 4)" .
  consider (r2) "s = 2 \<and> rid = 1" | (r3) "s = 3 \<and> rid = 3"
         | (r5) "s = 5 \<and> rid = 5" | (r8) "s = 8 \<and> rid = 2"
         | (r9) "s = 9 \<and> rid = 4"
    using s_rid by blast
  then show "x \<in> set test_reduce_edges"
  proof cases
    case r2
    have s_eq: "s = 2" and rid_eq: "rid = 1" using r2 by simp_all
    have p_eq: "p = p1" using prod rid_eq test_productions_1 by (metis option.inject)
    have lhs_eq: "lhs p = ''Eprime''" using p_eq by (simp add: p1_def)
    have g_eq: "g = 1" using gt lhs_eq test_goto_Eprime by metis
    show ?thesis using x_pair s_eq g_eq by (simp add: test_reduce_edges_def)
  next
    case r3
    have s_eq: "s = 3" and rid_eq: "rid = 3" using r3 by simp_all
    have p_eq: "p = p3" using prod rid_eq test_productions_3 by (metis option.inject)
    have lhs_eq: "lhs p = ''E''" using p_eq by (simp add: p3_def)
    have g_cases: "g = 2 \<or> g = 7" using gt lhs_eq test_goto_E by metis
    from g_cases show ?thesis
    proof
      assume "g = 2"
      then show ?thesis using x_pair s_eq by (simp add: test_reduce_edges_def)
    next
      assume "g = 7"
      then show ?thesis using x_pair s_eq by (simp add: test_reduce_edges_def)
    qed
  next
    case r5
    have s_eq: "s = 5" and rid_eq: "rid = 5" using r5 by simp_all
    have p_eq: "p = p5" using prod rid_eq test_productions_5 by (metis option.inject)
    have lhs_eq: "lhs p = ''T''" using p_eq by (simp add: p5_def)
    have g_cases: "g = 3 \<or> g = 8" using gt lhs_eq test_goto_T by metis
    from g_cases show ?thesis
    proof
      assume "g = 3"
      then show ?thesis using x_pair s_eq by (simp add: test_reduce_edges_def)
    next
      assume "g = 8"
      then show ?thesis using x_pair s_eq by (simp add: test_reduce_edges_def)
    qed
  next
    case r8
    have s_eq: "s = 8" and rid_eq: "rid = 2" using r8 by simp_all
    have p_eq: "p = p2" using prod rid_eq test_productions_2 by (metis option.inject)
    have lhs_eq: "lhs p = ''E''" using p_eq by (simp add: p2_def)
    have g_cases: "g = 2 \<or> g = 7" using gt lhs_eq test_goto_E by metis
    from g_cases show ?thesis
    proof
      assume "g = 2"
      then show ?thesis using x_pair s_eq by (simp add: test_reduce_edges_def)
    next
      assume "g = 7"
      then show ?thesis using x_pair s_eq by (simp add: test_reduce_edges_def)
    qed
  next
    case r9
    have s_eq: "s = 9" and rid_eq: "rid = 4" using r9 by simp_all
    have p_eq: "p = p4" using prod rid_eq test_productions_4 by (metis option.inject)
    have lhs_eq: "lhs p = ''T''" using p_eq by (simp add: p4_def)
    have g_cases: "g = 3 \<or> g = 8" using gt lhs_eq test_goto_T by metis
    from g_cases show ?thesis
    proof
      assume "g = 3"
      then show ?thesis using x_pair s_eq by (simp add: test_reduce_edges_def)
    next
      assume "g = 8"
      then show ?thesis using x_pair s_eq by (simp add: test_reduce_edges_def)
    qed
  qed
qed

text \<open>
  The generated rank on this table, and the decidable certificate: the check
  is a single computation on the concrete edge list, and the values below are
  the ones the generator produces, not values chosen by hand.
\<close>

lemma test_reduce_rank_check:
  "reduce_rank_check test_reduce_edges (auto_reduce_rank test_reduce_edges)"
  by eval

lemma test_reduce_rank_values:
  "test_reduce_rank 0 = 1" "test_reduce_rank 1 = 1" "test_reduce_rank 2 = 2"
  "test_reduce_rank 3 = 3" "test_reduce_rank 4 = 1" "test_reduce_rank 5 = 4"
  "test_reduce_rank 6 = 1" "test_reduce_rank 7 = 1" "test_reduce_rank 8 = 3"
  "test_reduce_rank 9 = 4"
  by eval+

lemma test_state_rank_certificate:
  "reduce_state_rank_certificate test_table (auto_reduce_rank test_reduce_edges)"
  by (rule reduce_state_rank_certificate_auto[OF test_reduce_graph_subset
        test_reduce_rank_check])

lemma test_reduce_graph_acyclic:
  "acyclic (reduce_graph test_table)"
  by (rule reduce_graph_acyclic_auto[OF test_reduce_graph_subset
        test_reduce_rank_check])

text \<open>
  Well-formedness is the only table property the auto route needs: the
  generic lemma @{thm [source] reduce_transition_correctI} turns it into
  @{text reduce_transition_correct} inside the schema.
\<close>

lemma wf_table_test_table: "wf_table test_table"
  unfolding wf_table_def
  by (auto simp: test_table_def test_action_def test_productions_def
      test_goto_def split: if_splits option.splits)

text \<open>
  The table never shifts the end marker, so the generic preservation lemma
  @{thm [source] input_invariant_stepI} applies without any case analysis on
  the table's action map.
\<close>

lemma test_end_shift_free: "end_shift_free test_table"
  unfolding end_shift_free_def
  by (simp add: test_table_def test_action_def)

text \<open>
  Termination of the test recognizer on an arbitrary token stream.  The
  lexicographic measure is (remaining input length, @{text "auto_reduce_rank test_reduce_edges"} of
  the top state); shifts decrease the first component, reductions the
  second.
\<close>

lemma test_termination_certificate:
  "termination_certificate test_table toks"
  by (rule termination_certificate_auto
      [OF wf_table_test_table test_end_shift_free
          test_reduce_graph_subset test_reduce_rank_check])

text \<open>
  The recognizer therefore terminates on every input, so the fuel bound of
  @{text run_detailed_fuel} can be removed on the test table.
\<close>

theorem test_lalr_termination:
  "finite_execution_target test_table toks"
  by (rule termination_certificate_finite_execution
      [OF test_termination_certificate])

corollary test_lalr_terminates:
  "\<exists>n r. run_rel test_table (init_config test_table toks) r n"
  using test_lalr_termination unfolding finite_execution_target_def .

end
