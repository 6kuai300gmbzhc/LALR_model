theory LALR_Soundness
  imports LALR_Symbol_Stack LALR_CFG_Bridge
begin

text \<open>
  Soundness: every word the recognizer accepts is generated by the grammar.

  The proof keeps one invariant along the run (see @{text parser_invariant}):
  the reconstructed symbol stack tracks the item sets of the state stack, and
  the symbols on it produce exactly the terminals consumed so far.  A shift
  extends both stacks consistently; a reduction replaces a right hand side --
  which tracking forces to be the suffix of the symbol stack -- by its left
  hand side, which leaves the yield unchanged by @{text parses_nonterminal}.

  Two obligations are not consequences of the item certificate and are kept
  explicit:
  \<^item> every reduction action corresponds to a real grammar production
    (the last conjunct of @{text lalr_sound_certificate}),
  \<^item> acceptance happens only with two states on the stack
    (@{text accept_shape}), the missing "no incoming edges of the start state"
    obligation of the plan (C6).
\<close>

section \<open>Auxiliary facts about items\<close>

lemma item_symbol_afterD:
  assumes "item_symbol_after t item = Some symbol0"
  shows "\<exists>p. productions t (fst item) = Some p \<and>
           snd item < length (rhs p) \<and> rhs p ! snd item = symbol0"
  using assms unfolding item_symbol_after_def
  by (auto split: option.splits if_splits)

lemma drop_append_single:
  "n \<le> length xs \<Longrightarrow> drop n (xs @ [y]) = drop n xs @ [y]"
  by simp

lemma take_append_le:
  "n \<le> length xs \<Longrightarrow> take n (xs @ [y]) = take n xs"
  by simp

section \<open>The closure only adds items with the dot at zero\<close>

lemma item_closure_step_dot_zero:
  assumes "\<forall>item \<in> items. snd item = 0"
  shows "\<forall>item \<in> item_closure_step t items. snd item = 0"
  using assms by (auto simp: item_closure_step_def)

lemma item_closure_dot_zero:
  assumes "\<forall>item \<in> items. snd item = 0"
  shows "\<forall>item \<in> item_closure t bound items. snd item = 0"
  using assms
proof (induction bound arbitrary: items)
  case 0
  then show ?case by (simp add: item_closure_def)
next
  case (Suc bound)
  from Suc.prems have step_zero: "\<forall>item \<in> item_closure_step t items. snd item = 0"
    by (rule item_closure_step_dot_zero)
  from Suc.IH[OF step_zero] show ?case
    by (simp add: item_closure_def)
qed

lemma item_closure_member_dot:
  "item \<in> item_closure t bound items \<Longrightarrow> item \<in> items \<or> snd item = 0"
proof (induction bound arbitrary: items)
  case 0
  then show ?case by (simp add: item_closure_def)
next
  case (Suc bound)
  from Suc.prems have mem: "item \<in> item_closure t bound (item_closure_step t items)"
    by (simp add: item_closure_def)
  from Suc.IH[OF mem] have "item \<in> item_closure_step t items \<or> snd item = 0" .
  then show ?case
  proof (rule disjE)
    assume "item \<in> item_closure_step t items"
    then show ?thesis by (auto simp: item_closure_step_def)
  next
    assume "snd item = 0"
    then show ?thesis by blast
  qed
qed

section \<open>Tracking a single stack position\<close>

lemma tracks_nil:
  assumes "\<forall>item \<in> state_items items s. snd item = 0"
  shows "tracks t items [] s"
  unfolding tracks_def
proof (intro allI ballI impI)
  fix item p
  assume mem: "item \<in> state_items items s"
    and prod: "productions t (fst item) = Some p"
  have "snd item = 0" using assms mem by blast
  show "snd item \<le> length [] \<and>
        take (snd item) (rhs p) = drop (length [] - snd item) []"
    using \<open>snd item = 0\<close> by simp
qed

text \<open>
  Reading one more symbol: the canonical goto of a tracked state is tracked by
  the extended symbol stack.  Items of the goto are advanced items of the
  source state (the dot moved past the symbol that was read); the items added
  by the closure have their dot at zero, which is consistent trivially.
\<close>

lemma tracks_append_symbol:
  assumes tr: "tracks t items \<sigma> s"
    and canon:
      "state_items items g =
        item_canonical_goto t bound (state_items items s) symbol0"
  shows "tracks t items (\<sigma> @ [symbol0]) g"
  unfolding tracks_def
proof (intro allI ballI impI)
  fix item p
  assume mem: "item \<in> state_items items g"
    and prod: "productions t (fst item) = Some p"
  have split: "item \<in> item_goto t (state_items items s) symbol0 \<or> snd item = 0"
  proof -
    have "item \<in> item_canonical_goto t bound (state_items items s) symbol0"
      using mem canon by simp
    then have "item \<in> item_closure t bound (item_goto t (state_items items s) symbol0)"
      by (simp add: item_canonical_goto_def)
    then show ?thesis by (rule item_closure_member_dot)
  qed
  show "snd item \<le> length (\<sigma> @ [symbol0]) \<and>
        take (snd item) (rhs p) =
          drop (length (\<sigma> @ [symbol0]) - snd item) (\<sigma> @ [symbol0])"
  proof (cases "item \<in> item_goto t (state_items items s) symbol0")
    case True
    from item_goto_member[OF True] obtain item0 where
      mem0: "item0 \<in> state_items items s"
      and after: "item_symbol_after t item0 = Some symbol0"
      and item_eq: "item = item_advance item0"
      by blast
    from item_symbol_afterD[OF after] obtain p0 where
      prod0: "productions t (fst item0) = Some p0"
      and len0: "snd item0 < length (rhs p0)"
      and nth0: "rhs p0 ! snd item0 = symbol0"
      by blast
    have fst_eq: "fst item = fst item0"
      using item_eq by (simp add: item_advance_def)
    have snd_eq: "snd item = Suc (snd item0)"
      using item_eq by (simp add: item_advance_def)
    have p_eq: "p = p0"
      using prod prod0 fst_eq by (metis option.inject)
    have len_le: "snd item0 \<le> length \<sigma>"
      using tracks_length_le[OF tr mem0 prod0] .
    have dot0: "take (snd item0) (rhs p0) = drop (length \<sigma> - snd item0) \<sigma>"
      using tracks_dot_match[OF tr mem0 prod0] .
    have dot: "take (snd item0) (rhs p) = drop (length \<sigma> - snd item0) \<sigma>"
      using dot0 p_eq by simp
    have rhs_nth: "rhs p ! snd item0 = symbol0" using nth0 p_eq by simp
    have len_rhs: "snd item0 < length (rhs p)" using len0 p_eq by simp
    have key: "take (snd item) (rhs p) =
               drop (length \<sigma> - snd item0) \<sigma> @ [symbol0]"
    proof -
      have "take (Suc (snd item0)) (rhs p) =
            take (snd item0) (rhs p) @ [rhs p ! snd item0]"
        by (rule take_Suc_conv_app_nth[OF len_rhs])
      then show ?thesis using snd_eq rhs_nth dot by simp
    qed
    have len_ok: "snd item \<le> length (\<sigma> @ [symbol0])"
      using snd_eq len_le by simp
    have drop_ok:
      "drop (length (\<sigma> @ [symbol0]) - snd item) (\<sigma> @ [symbol0]) =
       drop (length \<sigma> - snd item0) \<sigma> @ [symbol0]"
    proof -
      have idx: "length (\<sigma> @ [symbol0]) - snd item = length \<sigma> - snd item0"
        using snd_eq by simp
      have "drop (length \<sigma> - snd item0) (\<sigma> @ [symbol0]) =
            drop (length \<sigma> - snd item0) \<sigma> @ [symbol0]"
        by (rule drop_append_single) simp
      then show ?thesis using idx by simp
    qed
    show ?thesis using len_ok key drop_ok by simp
  next
    case False
    then have dot0: "snd item = 0" using split by blast
    show ?thesis using dot0 by simp
  qed
qed

section \<open>Tracking the whole state stack\<close>

lemma stack_tracks_len:
  assumes "stack_tracks t items \<sigma> stk"
  shows "length \<sigma> + 1 = length stk"
  using assms unfolding stack_tracks_def by blast

lemma stack_tracks_track:
  assumes "stack_tracks t items \<sigma> stk"
    and "j < length stk"
  shows "tracks t items (take j \<sigma>) (stk ! j)"
  using assms unfolding stack_tracks_def by blast

text \<open>The state on top of the stack sees the whole symbol stack.\<close>

lemma stack_tracks_top:
  assumes st: "stack_tracks t items \<sigma> stk"
    and top: "top_state stk = Some s"
  shows "tracks t items \<sigma> s"
proof -
  have len_st: "length \<sigma> + 1 = length stk"
    using st by (rule stack_tracks_len)
  have ne: "stk \<noteq> []" using len_st by auto
  have last_eq: "last stk = s"
    using top unfolding top_state_def by (auto split: if_splits)
  have j: "length \<sigma> < length stk" using len_st by simp
  have track: "tracks t items (take (length \<sigma>) \<sigma>) (stk ! length \<sigma>)"
    using st j by (rule stack_tracks_track)
  have idx: "length stk - 1 = length \<sigma>" using len_st by simp
  have nth_last: "stk ! (length stk - 1) = s"
    using last_eq ne by (metis last_conv_nth)
  have nth_eq: "stk ! length \<sigma> = s" using nth_last idx by simp
  show ?thesis using track nth_eq by simp
qed

lemma stack_tracks_append:
  assumes st: "stack_tracks t items \<sigma> stk"
    and top: "top_state stk = Some s"
    and canon:
      "state_items items st =
        item_canonical_goto t bound (state_items items s) symbol0"
  shows "stack_tracks t items (\<sigma> @ [symbol0]) (stk @ [st])"
proof -
  have len_st: "length \<sigma> + 1 = length stk"
    using st by (rule stack_tracks_len)
  have tracks_top: "tracks t items \<sigma> s"
    using st top by (rule stack_tracks_top)
  have tracks_new: "tracks t items (\<sigma> @ [symbol0]) st"
    using tracks_top canon by (rule tracks_append_symbol)
  have conj: "length (\<sigma> @ [symbol0]) + 1 = length (stk @ [st]) \<and>
              (\<forall>j < length (stk @ [st]).
                 tracks t items (take j (\<sigma> @ [symbol0])) ((stk @ [st]) ! j))"
  proof (intro conjI allI impI)
    show "length (\<sigma> @ [symbol0]) + 1 = length (stk @ [st])"
      using len_st by simp
    fix j
    assume j: "j < length (stk @ [st])"
    show "tracks t items (take j (\<sigma> @ [symbol0])) ((stk @ [st]) ! j)"
    proof (cases "j < length stk")
      case True
      have jle: "j \<le> length \<sigma>" using True len_st by simp
      have take_eq: "take j (\<sigma> @ [symbol0]) = take j \<sigma>"
        using jle by (rule take_append_le)
      have nth_eq: "(stk @ [st]) ! j = stk ! j"
        using True by (simp add: nth_append)
      have track: "tracks t items (take j \<sigma>) (stk ! j)"
        using st True by (rule stack_tracks_track)
      show ?thesis using track take_eq nth_eq by simp
    next
      case False
      with j have j_eq: "j = length stk" by simp
      have take_eq: "take j (\<sigma> @ [symbol0]) = \<sigma> @ [symbol0]"
        using j_eq len_st by simp
      have nth_eq: "(stk @ [st]) ! j = st"
        using j_eq by (simp add: nth_append)
      show ?thesis using tracks_new take_eq nth_eq by simp
    qed
  qed
  then show ?thesis unfolding stack_tracks_def by blast
qed

text \<open>Popping states keeps the tracking for the remaining stack.\<close>

lemma stack_tracks_pop:
  assumes st: "stack_tracks t items \<sigma> stk"
    and pop: "pop_rhs n stk = Some stk'"
  shows "stack_tracks t items (take (length \<sigma> - n) \<sigma>) stk'"
proof -
  have n_lt: "n < length stk"
    using pop by (simp add: pop_rhs_def split: if_splits)
  have stk'_eq: "stk' = take (length stk - n) stk"
    using pop by (simp add: pop_rhs_def split: if_splits)
  have len_st: "length \<sigma> + 1 = length stk"
    using st by (rule stack_tracks_len)
  have conj:
    "length (take (length \<sigma> - n) \<sigma>) + 1 = length stk' \<and>
     (\<forall>j < length stk'.
        tracks t items (take j (take (length \<sigma> - n) \<sigma>)) (stk' ! j))"
  proof (intro conjI allI impI)
    have n_le: "n \<le> length \<sigma>" using n_lt len_st by simp
    have take_len: "length (take (length \<sigma> - n) \<sigma>) = length \<sigma> - n"
      using n_le by simp
    have stk'_len: "length stk' = length stk - n"
      using stk'_eq by simp
    show "length (take (length \<sigma> - n) \<sigma>) + 1 = length stk'"
      using take_len stk'_len len_st n_lt by arith
    fix j
    assume j: "j < length stk'"
    have j_len_stk: "j < length stk" using stk'_eq j by simp
    have nth_eq: "stk' ! j = stk ! j" using stk'_eq j by (simp add: nth_take)
    have j_le: "j \<le> length \<sigma> - n" using j stk'_eq len_st by simp
    have take_eq: "take j (take (length \<sigma> - n) \<sigma>) = take j \<sigma>"
      using j_le by simp
    have track: "tracks t items (take j \<sigma>) (stk ! j)"
      using st j_len_stk by (rule stack_tracks_track)
    show "tracks t items (take j (take (length \<sigma> - n) \<sigma>)) (stk' ! j)"
      using track take_eq nth_eq by simp
  qed
  then show ?thesis unfolding stack_tracks_def by blast
qed

section \<open>Yield lemmas for one reduction\<close>

lemma parses_single_terminal:
  "parses G [Terminal a] [Terminal a]"
  using parses_terminal[OF parses_nil] by simp

lemma parses_single_nonterminal:
  assumes rule: "(A, \<alpha>) \<in> set (\<RR> G)"
    and body: "parses G \<alpha> w"
  shows "parses G [Nonterminal A] w"
  using parses_nonterminal[OF rule body parses_nil] by simp

lemma parses_replace_suffix:
  assumes p: "parses G (prefix @ rhs p) w"
    and rule: "(lhs p, rhs p) \<in> set (\<RR> G)"
  shows "parses G (prefix @ [Nonterminal (lhs p)]) w"
proof -
  from parses_append_split[OF p] obtain w1 w2 where
    w_eq: "w = w1 @ w2"
    and p1: "parses G prefix w1"
    and p2: "parses G (rhs p) w2"
    by blast
  have nt: "parses G [Nonterminal (lhs p)] w2"
    using rule p2 by (rule parses_single_nonterminal)
  have "parses G (prefix @ [Nonterminal (lhs p)]) (w1 @ w2)"
    using p1 nt by (rule parses_append)
  then show ?thesis using w_eq by simp
qed

section \<open>The certificate and its projections\<close>

definition lalr_sound_certificate ::
  "symbol cfg \<Rightarrow> lalr_table \<Rightarrow> state_item_map \<Rightarrow> nat \<Rightarrow>
   item_set \<Rightarrow> state_lookahead_map \<Rightarrow> bool" where
  "lalr_sound_certificate G t items bound initial_items lookaheads \<longleftrightarrow>
     wf_table t \<and>
     action_entries_wf t \<and>
     state_items_certificate t items bound initial_items \<and>
     lalr_reduce_action_correct t items lookaheads \<and>
     lalr_accept_action_correct G t items \<and>
     (\<forall>s tok rid p. actions t s tok = Some (ActReduce rid) \<longrightarrow>
        productions t rid = Some p \<longrightarrow> (lhs p, rhs p) \<in> set (\<RR> G))"

lemma lalr_sound_certificate_wf:
  "lalr_sound_certificate G t items bound initial_items lookaheads \<Longrightarrow> wf_table t"
  by (simp add: lalr_sound_certificate_def)

lemma lalr_sound_certificate_actions:
  "lalr_sound_certificate G t items bound initial_items lookaheads \<Longrightarrow>
   action_entries_wf t"
  by (simp add: lalr_sound_certificate_def)

lemma lalr_sound_certificate_items:
  "lalr_sound_certificate G t items bound initial_items lookaheads \<Longrightarrow>
   state_items_certificate t items bound initial_items"
  by (simp add: lalr_sound_certificate_def)

lemma lalr_sound_certificate_reduce:
  "lalr_sound_certificate G t items bound initial_items lookaheads \<Longrightarrow>
   lalr_reduce_action_correct t items lookaheads"
  by (simp add: lalr_sound_certificate_def)

lemma lalr_sound_certificate_accept:
  "lalr_sound_certificate G t items bound initial_items lookaheads \<Longrightarrow>
   lalr_accept_action_correct G t items"
  by (simp add: lalr_sound_certificate_def)

lemma lalr_sound_certificate_real:
  "\<lbrakk>lalr_sound_certificate G t items bound initial_items lookaheads;
    actions t s tok = Some (ActReduce rid); productions t rid = Some p\<rbrakk>
   \<Longrightarrow> (lhs p, rhs p) \<in> set (\<RR> G)"
  by (simp add: lalr_sound_certificate_def)

lemma end_shift_free_of_action_entries:
  assumes "action_entries_wf t"
  shows "end_shift_free t"
  using assms unfolding end_shift_free_def action_entries_wf_def by blast

lemma lalr_reduce_action_correctD:
  assumes rc: "lalr_reduce_action_correct t items lookaheads"
    and mem: "s \<in> states t"
    and act: "actions t s tok = Some (ActReduce rid)"
  shows "\<exists>p. productions t rid = Some p \<and>
             item_complete t (rid, length (rhs p)) \<and>
             (rid, length (rhs p)) \<in> state_items items s"
  using rc mem act unfolding lalr_reduce_action_correct_def by blast

lemma lalr_accept_action_correctD:
  assumes ac: "lalr_accept_action_correct G t items"
    and mem: "s \<in> states t"
    and act: "actions t s end_token = Some ActAccept"
  shows "\<exists>rid p. productions t rid = Some p \<and>
             rhs p = [Nonterminal (\<SS> G)] \<and>
             item_complete t (rid, length (rhs p)) \<and>
             (rid, length (rhs p)) \<in> state_items items s"
  using ac mem act unfolding lalr_accept_action_correct_def by blast

section \<open>The invariant along a run\<close>

definition parser_invariant ::
  "symbol cfg \<Rightarrow> lalr_table \<Rightarrow> state_item_map \<Rightarrow>
   token list \<Rightarrow> config \<Rightarrow> bool" where
  "parser_invariant G t items toks cfg \<longleftrightarrow>
     input_invariant toks cfg \<and>
     (\<exists>\<sigma>. stack_symbols t toks cfg \<sigma> \<and>
           stack_tracks t items \<sigma> (state_stack cfg) \<and>
           parses G \<sigma> (map Terminal (consumed_tokens cfg)))"

lemma parser_invariantD:
  assumes "parser_invariant G t items toks cfg"
  shows "input_invariant toks cfg"
    and "\<exists>\<sigma>. stack_symbols t toks cfg \<sigma> \<and>
           stack_tracks t items \<sigma> (state_stack cfg) \<and>
           parses G \<sigma> (map Terminal (consumed_tokens cfg))"
  using assms unfolding parser_invariant_def by simp_all

lemma parser_invariantI:
  assumes "input_invariant toks cfg"
    and "\<exists>\<sigma>. stack_symbols t toks cfg \<sigma> \<and>
           stack_tracks t items \<sigma> (state_stack cfg) \<and>
           parses G \<sigma> (map Terminal (consumed_tokens cfg))"
  shows "parser_invariant G t items toks cfg"
  using assms unfolding parser_invariant_def by simp

lemma parser_invariant_init:
  assumes cert: "state_items_certificate t items bound initial_items"
    and dots: "\<forall>item \<in> initial_items. snd item = 0"
    and start: "start_state t \<in> states t"
  shows "parser_invariant G t items toks (init_config t toks)"
proof (rule parser_invariantI)
  show "input_invariant toks (init_config t toks)"
    by (rule input_invariant_init)
  show "\<exists>\<sigma>. stack_symbols t toks (init_config t toks) \<sigma> \<and>
             stack_tracks t items \<sigma> (state_stack (init_config t toks)) \<and>
             parses G \<sigma> (map Terminal (consumed_tokens (init_config t toks)))"
  proof (rule exI[where x = "[]"], intro conjI)
    show "stack_symbols t toks (init_config t toks) []"
      by (rule stack_symbols_init)
    show "stack_tracks t items [] (state_stack (init_config t toks))"
    proof -
      have items_start: "state_items items (start_state t) =
            item_closure t bound initial_items"
        using cert start unfolding state_items_certificate_def by blast
      have dots_start: "\<forall>item \<in> state_items items (start_state t). snd item = 0"
      proof -
        have "\<forall>item \<in> item_closure t bound initial_items. snd item = 0"
          using dots by (rule item_closure_dot_zero)
        then show ?thesis using items_start by simp
      qed
      have "stack_tracks t items [] [start_state t]"
      proof (unfold stack_tracks_def, intro conjI allI impI)
        show "length [] + 1 = length [start_state t]" by simp
        fix j
        assume "j < length [start_state t]"
        then have j0: "j = 0" by simp
        show "tracks t items (take j []) ([start_state t] ! j)"
          using j0 dots_start by (simp add: tracks_nil)
      qed
      then show ?thesis by (simp add: init_config_def)
    qed
    show "parses G [] (map Terminal (consumed_tokens (init_config t toks)))"
      by (simp add: consumed_tokens_init, rule parses_nil)
  qed
qed

text \<open>Shifts: the dot of the expected item moves past the terminal.\<close>

lemma shift_step_position:
  assumes sh: "shift_step t cfg cfg'"
  shows "position cfg' = Suc (position cfg)"
  using sh unfolding shift_step_def
  by (auto simp: one_step_def append_trace_def split: option.splits action.splits if_splits)

lemma parser_invariant_shift:
  assumes inv: "parser_invariant G t items toks cfg"
    and c: "lalr_sound_certificate G t items bound initial_items lookaheads"
    and sh: "shift_step t cfg cfg'"
  shows "parser_invariant G t items toks cfg'"
proof -
  have cert: "state_items_certificate t items bound initial_items"
    using c by (rule lalr_sound_certificate_items)
  have ae: "action_entries_wf t"
    using c by (rule lalr_sound_certificate_actions)
  from inv have inv_input: "input_invariant toks cfg"
    and inv_symbols: "\<exists>\<sigma>. stack_symbols t toks cfg \<sigma> \<and>
          stack_tracks t items \<sigma> (state_stack cfg) \<and>
          parses G \<sigma> (map Terminal (consumed_tokens cfg))"
    by (rule parser_invariantD)+
  from inv_symbols obtain \<sigma> where
    symbols: "stack_symbols t toks cfg \<sigma>"
    and stracks: "stack_tracks t items \<sigma> (state_stack cfg)"
    and parses_cfg: "parses G \<sigma> (map Terminal (consumed_tokens cfg))"
    by blast
  from sh obtain s st where
    top: "top_state (state_stack cfg) = Some s"
    and pos_lt: "position cfg < length (input_tokens cfg)"
    and act: "actions t s (input_tokens cfg ! position cfg) = Some (ActShift st)"
    and nxt: "one_step t cfg = Next cfg'"
    unfolding shift_step_def by blast
  have s_mem: "s \<in> states t"
    using ae act unfolding action_entries_wf_def by blast
  have free: "end_shift_free t"
    using ae by (rule end_shift_free_of_action_entries)
  have stack_eq: "state_stack cfg' = state_stack cfg @ [st]"
    using nxt top act by (rule one_step_shift_stack)
  have canon: "state_items items st =
       item_canonical_goto t bound (state_items items s)
         (Terminal (input_tokens cfg ! position cfg))"
    using state_items_certificate_shiftD[OF cert s_mem act] by blast
  have new_tracks:
    "stack_tracks t items (\<sigma> @ [Terminal (input_tokens cfg ! position cfg)])
       (state_stack cfg @ [st])"
    using stack_tracks_append[OF stracks top canon] .
  have new_symbols:
    "stack_symbols t toks cfg' (\<sigma> @ [Terminal (input_tokens cfg ! position cfg)])"
    using symbols top act nxt by (rule symbols_shift)
  have new_input: "input_invariant toks cfg'"
    using input_invariant_stepI[OF inv_input nxt free] .
  have pos_suc: "position cfg' = Suc (position cfg)"
    using shift_step_position[OF sh] .
  have input_eq: "input_tokens cfg' = input_tokens cfg"
    using one_step_next_input_frame[OF nxt] by blast
  have consumed: "consumed_tokens cfg' =
        consumed_tokens cfg @ [input_tokens cfg ! position cfg]"
    by (simp add: consumed_tokens_def pos_suc input_eq pos_lt take_Suc_conv_app_nth)
  have new_parses:
    "parses G (\<sigma> @ [Terminal (input_tokens cfg ! position cfg)])
       (map Terminal (consumed_tokens cfg'))"
  proof -
    have map_eq: "map Terminal (consumed_tokens cfg') =
          map Terminal (consumed_tokens cfg) @ [Terminal (input_tokens cfg ! position cfg)]"
      by (simp add: consumed)
    have "parses G (\<sigma> @ [Terminal (input_tokens cfg ! position cfg)])
          (map Terminal (consumed_tokens cfg) @ [Terminal (input_tokens cfg ! position cfg)])"
      using parses_cfg parses_single_terminal by (rule parses_append)
    then show ?thesis using map_eq by simp
  qed
  show ?thesis
  proof (rule parser_invariantI)
    show "input_invariant toks cfg'" by (rule new_input)
    show "\<exists>\<sigma>. stack_symbols t toks cfg' \<sigma> \<and>
               stack_tracks t items \<sigma> (state_stack cfg') \<and>
               parses G \<sigma> (map Terminal (consumed_tokens cfg'))"
    proof (rule exI[where x = "\<sigma> @ [Terminal (input_tokens cfg ! position cfg)]"],
        intro conjI)
      show "stack_symbols t toks cfg'
              (\<sigma> @ [Terminal (input_tokens cfg ! position cfg)])"
        by (rule new_symbols)
      show "stack_tracks t items
              (\<sigma> @ [Terminal (input_tokens cfg ! position cfg)]) (state_stack cfg')"
        by (subst stack_eq, rule new_tracks)
      show "parses G (\<sigma> @ [Terminal (input_tokens cfg ! position cfg)])
              (map Terminal (consumed_tokens cfg'))"
        by (rule new_parses)
    qed
  qed
qed

text \<open>
  Reductions pop the states of the right hand side and push the goto of the
  left hand side.  Tracking at the top state forces the popped symbols to be
  exactly that right hand side, so the yield is unchanged.
\<close>

lemma parser_invariant_reduce:
  assumes inv: "parser_invariant G t items toks cfg"
    and c: "lalr_sound_certificate G t items bound initial_items lookaheads"
    and reach: "reachable_cfg t toks cfg"
    and red: "reduce_step t cfg cfg'"
  shows "parser_invariant G t items toks cfg'"
proof -
  have cert: "state_items_certificate t items bound initial_items"
    using c by (rule lalr_sound_certificate_items)
  have ae: "action_entries_wf t"
    using c by (rule lalr_sound_certificate_actions)
  have wf: "wf_table t"
    using c by (rule lalr_sound_certificate_wf)
  have rc: "lalr_reduce_action_correct t items lookaheads"
    using c by (rule lalr_sound_certificate_reduce)
  have real: "\<And>s tok rid p. actions t s tok = Some (ActReduce rid) \<Longrightarrow>
       productions t rid = Some p \<Longrightarrow> (lhs p, rhs p) \<in> set (\<RR> G)"
    using c by (rule lalr_sound_certificate_real)
  from inv have inv_input: "input_invariant toks cfg"
    and inv_symbols: "\<exists>\<sigma>. stack_symbols t toks cfg \<sigma> \<and>
          stack_tracks t items \<sigma> (state_stack cfg) \<and>
          parses G \<sigma> (map Terminal (consumed_tokens cfg))"
    by (rule parser_invariantD)+
  from inv_symbols obtain \<sigma> where
    symbols: "stack_symbols t toks cfg \<sigma>"
    and stracks: "stack_tracks t items \<sigma> (state_stack cfg)"
    and parses_cfg: "parses G \<sigma> (map Terminal (consumed_tokens cfg))"
    by blast
  from reduce_step_stack_decomposition[OF red] obtain s rid p stk' s' g where
    top: "top_state (state_stack cfg) = Some s"
    and act: "actions t s (input_tokens cfg ! position cfg) = Some (ActReduce rid)"
    and prod: "productions t rid = Some p"
    and pop: "pop_rhs (length (rhs p)) (state_stack cfg) = Some stk'"
    and top': "top_state stk' = Some s'"
    and gotos: "gotos t s' (lhs p) = Some g"
    and stack_eq: "state_stack cfg' = stk' @ [g]"
    by blast
  have s_mem: "s \<in> states t"
    using ae act unfolding action_entries_wf_def by blast
  have nxt: "one_step t cfg = Next cfg'"
    using red unfolding reduce_step_def by blast
  have pos_eq: "position cfg' = position cfg"
    using reduce_step_position[OF red] .
  have frame: "input_tokens cfg' = input_tokens cfg"
    using one_step_next_input_frame[OF nxt] by blast
  have consumed_eq: "consumed_tokens cfg' = consumed_tokens cfg"
    by (simp add: consumed_tokens_def pos_eq frame)
  text \<open>The completed item on top of the stack matches the right hand side.\<close>
  have mem_p: "(rid, length (rhs p)) \<in> state_items items s"
  proof -
    from lalr_reduce_action_correctD[OF rc s_mem act] obtain q where
      prod_q: "productions t rid = Some q"
      and mem_q: "(rid, length (rhs q)) \<in> state_items items s"
      by blast
    have q_eq: "q = p" using prod prod_q by (metis option.inject)
    show ?thesis using mem_q q_eq by metis
  qed
  have track_top: "tracks t items \<sigma> s"
    using stack_tracks_top[OF stracks top] .
  have suffix: "\<sigma> = take (length \<sigma> - length (rhs p)) \<sigma> @ rhs p"
  proof (rule tracks_complete_suffix[where item = "(rid, length (rhs p))"])
    show "tracks t items \<sigma> s" using track_top .
    show "(rid, length (rhs p)) \<in> state_items items s" using mem_p .
    show "productions t (fst (rid, length (rhs p))) = Some p" using prod by simp
    show "snd (rid, length (rhs p)) = length (rhs p)" by simp
  qed
  have n_le: "length (rhs p) \<le> length \<sigma>"
    using suffix by (metis length_append le_add2)
  have stack_symbols':
    "stack_symbols t toks cfg' (take (length \<sigma> - length (rhs p)) \<sigma> @ [Nonterminal (lhs p)])"
    using symbols_reduce[OF symbols top act prod nxt] .
  have stk_sub: "set (state_stack cfg) \<subseteq> states t"
    using reachable_cfg_stack_states[OF wf reach] .
  have stk'_sub: "set stk' \<subseteq> set (state_stack cfg)"
  proof (rule subsetI)
    fix x
    assume x_mem: "x \<in> set stk'"
    have "stk' = take (length (state_stack cfg) - length (rhs p)) (state_stack cfg)"
      using pop by (simp add: pop_rhs_def split: if_splits)
    then have "x \<in> set (take (length (state_stack cfg) - length (rhs p)) (state_stack cfg))"
      using x_mem by simp
    then show "x \<in> set (state_stack cfg)" by (rule in_set_takeD)
  qed
  have s'_mem: "s' \<in> states t"
  proof -
    have "s' \<in> set stk'"
      using top' unfolding top_state_def by (auto split: if_splits)
    then show ?thesis using stk'_sub stk_sub by blast
  qed
  have g_canon:
    "state_items items g =
      item_canonical_goto t bound (state_items items s') (Nonterminal (lhs p))"
    using state_items_certificate_gotoD[OF cert s'_mem gotos] by blast
  have pop_tracks:
    "stack_tracks t items (take (length \<sigma> - length (rhs p)) \<sigma>) stk'"
    using stack_tracks_pop[OF stracks pop] .
  have stracks':
    "stack_tracks t items
      (take (length \<sigma> - length (rhs p)) \<sigma> @ [Nonterminal (lhs p)]) (state_stack cfg')"
  proof -
    have "stack_tracks t items
          (take (length \<sigma> - length (rhs p)) \<sigma> @ [Nonterminal (lhs p)]) (stk' @ [g])"
      using stack_tracks_append[OF pop_tracks top' g_canon] .
    then show ?thesis using stack_eq by simp
  qed
  have new_parses:
    "parses G (take (length \<sigma> - length (rhs p)) \<sigma> @ [Nonterminal (lhs p)])
       (map Terminal (consumed_tokens cfg'))"
  proof -
    have rule: "(lhs p, rhs p) \<in> set (\<RR> G)"
      using real[OF act prod] .
    have split_parses: "parses G (take (length \<sigma> - length (rhs p)) \<sigma> @ rhs p)
            (map Terminal (consumed_tokens cfg))"
      using parses_cfg suffix by metis
    have "parses G (take (length \<sigma> - length (rhs p)) \<sigma> @ [Nonterminal (lhs p)])
            (map Terminal (consumed_tokens cfg))"
      using split_parses rule by (rule parses_replace_suffix)
    then show ?thesis by (simp add: consumed_eq)
  qed
  have free: "end_shift_free t"
    using ae by (rule end_shift_free_of_action_entries)
  have new_input: "input_invariant toks cfg'"
    using input_invariant_stepI[OF inv_input nxt free] .
  show ?thesis
  proof (rule parser_invariantI)
    show "input_invariant toks cfg'" by (rule new_input)
    show "\<exists>\<sigma>. stack_symbols t toks cfg' \<sigma> \<and>
               stack_tracks t items \<sigma> (state_stack cfg') \<and>
               parses G \<sigma> (map Terminal (consumed_tokens cfg'))"
    proof (rule exI[where x = "take (length \<sigma> - length (rhs p)) \<sigma> @ [Nonterminal (lhs p)]"],
        intro conjI)
      show "stack_symbols t toks cfg'
              (take (length \<sigma> - length (rhs p)) \<sigma> @ [Nonterminal (lhs p)])"
        by (rule stack_symbols')
      show "stack_tracks t items
              (take (length \<sigma> - length (rhs p)) \<sigma> @ [Nonterminal (lhs p)])
              (state_stack cfg')"
        by (rule stracks')
      show "parses G (take (length \<sigma> - length (rhs p)) \<sigma> @ [Nonterminal (lhs p)])
              (map Terminal (consumed_tokens cfg'))"
        by (rule new_parses)
    qed
  qed
qed

lemma parser_invariant_step:
  assumes inv: "parser_invariant G t items toks cfg"
    and c: "lalr_sound_certificate G t items bound initial_items lookaheads"
    and reach: "reachable_cfg t toks cfg"
    and nxt: "one_step t cfg = Next cfg'"
  shows "parser_invariant G t items toks cfg'"
proof (rule disjE[OF next_is_shift_or_reduce[OF nxt]])
  assume sh: "shift_step t cfg cfg'"
  from parser_invariant_shift[OF inv c sh] show "parser_invariant G t items toks cfg'" .
next
  assume red: "reduce_step t cfg cfg'"
  from parser_invariant_reduce[OF inv c reach red] show "parser_invariant G t items toks cfg'" .
qed

lemma parser_invariant_reachable:
  "reachable_cfg t toks cfg \<Longrightarrow>
   lalr_sound_certificate G t items bound initial_items lookaheads \<Longrightarrow>
   (\<forall>item \<in> initial_items. snd item = 0) \<Longrightarrow>
   parser_invariant G t items toks (init_config t toks) \<Longrightarrow>
   parser_invariant G t items toks cfg"
proof (induction rule: reachable_cfg.induct)
  case reachable_cfg_init
  then show ?case by blast
next
  case reachable_cfg_next
  then show ?case by (blast intro: parser_invariant_step)
qed

section \<open>From a finished run to a derivation\<close>

lemma run_rel_done_reachable:
  "run_rel t cfg r n \<Longrightarrow>
   reachable_cfg t toks cfg \<Longrightarrow>
   (\<exists>cfg'. reachable_cfg t toks cfg' \<and> one_step t cfg' = Done r)"
proof (induction rule: run_rel.induct)
  case run_rel_done
  then show ?case by blast
next
  case run_rel_next
  then show ?case by (blast intro: reachable_cfg_next)
qed

text \<open>
  Acceptance: the lookahead is the end marker, the state on top of the stack
  carries a completed item of the augmented start production, and tracking
  forces the symbol stack to be the start symbol alone.  The symbols then
  parse the consumed input, which by @{text ordinary_input} is all of it.
\<close>

theorem accepts_sound:
  assumes c: "lalr_sound_certificate G t items bound initial_items lookaheads"
    and dots: "\<forall>item \<in> initial_items. snd item = 0"
    and shape: "\<And>cfg tr. reachable_cfg t toks cfg \<Longrightarrow>
      one_step t cfg = Done (Accepted tr) \<Longrightarrow> length (state_stack cfg) = 2"
    and ordinary: "ordinary_input t toks"
    and acc: "accepts t toks"
  shows "toks \<in> language G"
proof -
  have cert: "state_items_certificate t items bound initial_items"
    using c by (rule lalr_sound_certificate_items)
  have ae: "action_entries_wf t"
    using c by (rule lalr_sound_certificate_actions)
  have wf: "wf_table t"
    using c by (rule lalr_sound_certificate_wf)
  have acc_correct: "lalr_accept_action_correct G t items"
    using c by (rule lalr_sound_certificate_accept)
  from acc have run_ex: "\<exists>n tr. run_rel t (init_config t toks) (Accepted tr) n"
    unfolding accepts_def by blast
  then obtain n tr where
    run: "run_rel t (init_config t toks) (Accepted tr) n"
    by blast
  have start_mem: "start_state t \<in> states t"
    using wf unfolding wf_table_def by blast
  have init_inv: "parser_invariant G t items toks (init_config t toks)"
    using parser_invariant_init[OF cert dots start_mem] .
  have start_reach: "reachable_cfg t toks (init_config t toks)"
    by (rule reachable_cfg_init)
  from run_rel_done_reachable[OF run start_reach] obtain cfg where
    reach: "reachable_cfg t toks cfg"
    and acc_step: "one_step t cfg = Done (Accepted tr)"
    by blast
  have inv: "parser_invariant G t items toks cfg"
    using parser_invariant_reachable[OF reach c dots init_inv] .
  have inv_input: "input_invariant toks cfg"
    using parser_invariantD[OF inv] by blast
  have inv_symbols: "\<exists>\<sigma>. stack_symbols t toks cfg \<sigma> \<and>
        stack_tracks t items \<sigma> (state_stack cfg) \<and>
        parses G \<sigma> (map Terminal (consumed_tokens cfg))"
    using parser_invariantD[OF inv] by blast
  then obtain \<sigma> where sigma_props:
      "stack_symbols t toks cfg \<sigma> \<and>
       stack_tracks t items \<sigma> (state_stack cfg) \<and>
       parses G \<sigma> (map Terminal (consumed_tokens cfg))"
    by blast
  have symbols: "stack_symbols t toks cfg \<sigma>"
    using sigma_props by blast
  have stracks: "stack_tracks t items \<sigma> (state_stack cfg)"
    using sigma_props by blast
  have parses_cfg: "parses G \<sigma> (map Terminal (consumed_tokens cfg))"
    using sigma_props by blast
  have acc_dec: "position cfg < length (input_tokens cfg) \<and>
        (\<exists>s. top_state (state_stack cfg) = Some s \<and>
             actions t s (input_tokens cfg ! position cfg) = Some ActAccept)"
    using acc_step unfolding one_step_def Let_def
    by (auto split: option.splits action.splits if_splits)
  have pos_lt: "position cfg < length (input_tokens cfg)"
    using acc_dec by blast
  have act_ex: "\<exists>s. top_state (state_stack cfg) = Some s \<and>
        actions t s (input_tokens cfg ! position cfg) = Some ActAccept"
    using acc_dec by blast
  then obtain s where s_props:
      "top_state (state_stack cfg) = Some s \<and>
       actions t s (input_tokens cfg ! position cfg) = Some ActAccept"
    by blast
  have top: "top_state (state_stack cfg) = Some s"
    using s_props by blast
  have act: "actions t s (input_tokens cfg ! position cfg) = Some ActAccept"
    using s_props by blast
  have s_mem: "s \<in> states t"
    using ae act unfolding action_entries_wf_def by blast
  have tok_end: "input_tokens cfg ! position cfg = end_token"
    using ae act unfolding action_entries_wf_def by blast
  have input_eq: "input_tokens cfg = toks @ [end_token]"
    using inv_input unfolding input_invariant_def by blast
  have pos_le: "position cfg \<le> length toks"
    using inv_input unfolding input_invariant_def by blast
  text \<open>The lookahead is the end marker only after the whole input was read.\<close>
  have pos_len: "position cfg = length toks"
  proof (rule ccontr)
    assume neq: "position cfg \<noteq> length toks"
    with pos_le have lt: "position cfg < length toks" by simp
    have b: "(toks @ [end_token]) ! position cfg = toks ! position cfg"
      by (simp add: nth_append lt)
    have c: "input_tokens cfg ! position cfg = (toks @ [end_token]) ! position cfg"
      by (simp add: input_eq)
    have nth: "toks ! position cfg = end_token"
      using c b tok_end by metis
    have mem: "toks ! position cfg \<in> set toks"
      by (metis lt nth_mem)
    have in_end: "end_token \<in> set toks"
      using nth mem by metis
    have not_in: "end_token \<notin> set toks"
      using ordinary by (rule ordinary_input_no_end)
    from in_end not_in show False by blast
  qed
  have consumed_eq: "consumed_tokens cfg = toks"
    using pos_len input_eq unfolding consumed_tokens_def by simp
  have accept_clause: "actions t s end_token = Some ActAccept"
    by (metis act tok_end)
  have accept_ex: "\<exists>rid p. productions t rid = Some p \<and>
        rhs p = [Nonterminal (\<SS> G)] \<and>
        item_complete t (rid, length (rhs p)) \<and>
        (rid, length (rhs p)) \<in> state_items items s"
    using lalr_accept_action_correctD[OF acc_correct s_mem accept_clause] .
  then obtain rid p where accept_props:
      "productions t rid = Some p \<and>
       rhs p = [Nonterminal (\<SS> G)] \<and>
       item_complete t (rid, length (rhs p)) \<and>
       (rid, length (rhs p)) \<in> state_items items s"
    by blast
  have prod: "productions t rid = Some p"
    using accept_props by blast
  have rhs_p: "rhs p = [Nonterminal (\<SS> G)]"
    using accept_props by blast
  have mem: "(rid, length (rhs p)) \<in> state_items items s"
    using accept_props by blast
  have len_stk: "length \<sigma> + 1 = length (state_stack cfg)"
    using stracks by (rule stack_tracks_len)
  have stack_two: "length (state_stack cfg) = 2"
    by (rule shape[OF reach acc_step])
  have sigma_one: "length \<sigma> = 1"
    using len_stk stack_two by arith
  have track_top: "tracks t items \<sigma> s"
    using stack_tracks_top[OF stracks top] .
  have len_rhs: "length (rhs p) = 1"
    by (simp add: rhs_p)
  have suffix: "\<sigma> = take (length \<sigma> - length (rhs p)) \<sigma> @ rhs p"
  proof (rule tracks_complete_suffix[where item = "(rid, length (rhs p))"])
    show "tracks t items \<sigma> s" using track_top .
    show "(rid, length (rhs p)) \<in> state_items items s" using mem .
    show "productions t (fst (rid, length (rhs p))) = Some p" using prod by simp
    show "snd (rid, length (rhs p)) = length (rhs p)" by simp
  qed
  have take_nil: "take (length \<sigma> - length (rhs p)) \<sigma> = []"
    by (simp add: sigma_one len_rhs)
  have sigma_eq: "\<sigma> = [Nonterminal (\<SS> G)]"
  proof -
    have zero: "take (length \<sigma> - length (rhs p)) \<sigma> = []"
      by (rule take_nil)
    have cons: "take (length \<sigma> - length (rhs p)) \<sigma> @ rhs p = rhs p"
      using zero by simp
    have step: "\<sigma> = rhs p"
      using suffix[unfolded cons] .
    then show ?thesis using rhs_p by simp
  qed
  have parses_start: "parses G [Nonterminal (\<SS> G)] (map Terminal toks)"
    using parses_cfg consumed_eq sigma_eq by metis
  have derives_start: "derives G [Nonterminal (\<SS> G)] (map Terminal toks)"
    using parses_start by (rule parses_derives)
  show ?thesis
    by (simp add: language_def derives_start)
qed

end
