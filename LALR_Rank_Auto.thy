theory LALR_Rank_Auto
  imports LALR_Termination
begin

text \<open>
  Automatic reduction ranks, in an executable formulation.

  The termination interface only needs a state rank that strictly decreases
  along every edge of @{const reduce_graph}, the finite over-approximation of
  the reduction relation of a table.  Such a rank is the height of the graph,
  and the height is computed by iterating the step

    \<open>r\<^sub>n+1(s) = 1 + max {r\<^sub>n(g) | s \<rightarrow> g}\<close>

  from the constant zero function: a state at the end of a chain of \<open>k\<close>
  edges has value \<open>k + 1\<close> after \<open>k + 1\<close> rounds.

  The earlier version of this theory took the successor set from
  @{const reduce_graph} itself and defined the height by @{const wfrec}.  That
  specification is not executable: @{const reduce_graph} is a set
  comprehension over the state type @{typ state} (an abbreviation for
  @{typ nat}), and code generation for a set comprehension requires an
  @{class enum} instance for the element type, which @{typ nat} does not have.
  The code generator rejects it with
  \textit{Wellsortedness error: Type @{typ "nat \<times> nat"} not of sort @{class enum}}.
  As a consequence every concrete rank value had to be derived by hand, and
  each such derivation rebuilt the map lookups of the table.

  The present formulation therefore takes the finite list of reduction edges
  as an explicit parameter.  The step, the iteration and the generated rank
  are then plain list and arithmetic operations, so the rank is produced by
  evaluation and the certificate is discharged by the executable predicate
  @{text reduce_rank_check}.  Nothing on the executable path mentions
  @{const reduce_graph}: the inclusion @{prop "reduce_graph t \<subseteq> set es"}
  is the only bridge that the termination interface needs, and it is proved
  once per table.
\<close>

text \<open>The successors of a state in a finite edge list.\<close>

definition reduce_succs :: "(state \<times> state) list \<Rightarrow> state \<Rightarrow> state set" where
  "reduce_succs es s = set (map snd (filter (\<lambda>e. fst e = s) es))"

text \<open>One round of the height iteration.\<close>

definition reduce_rank_step ::
  "(state \<times> state) list \<Rightarrow> (state \<Rightarrow> nat) \<Rightarrow> state \<Rightarrow> nat" where
  "reduce_rank_step es f s = Suc (Max (insert 0 (f ` reduce_succs es s)))"

primrec reduce_rank_iter :: "(state \<times> state) list \<Rightarrow> nat \<Rightarrow> (state \<Rightarrow> nat)" where
  "reduce_rank_iter es 0 = (\<lambda>_. 0)"
| "reduce_rank_iter es (Suc n) = reduce_rank_step es (reduce_rank_iter es n)"

text \<open>
  The fuel is the number of edges plus one.  A chain in an acyclic graph uses
  pairwise distinct edges, so its length is at most @{term "length es"} and
  the height is at most @{term "Suc (length es)"}, which is the round after
  which the iteration has certainly stabilized.  The generated function does
  not depend on acyclicity: on a cyclic edge list it simply returns a value
  that fails the check below.
\<close>

definition auto_reduce_rank :: "(state \<times> state) list \<Rightarrow> state \<Rightarrow> nat" where
  "auto_reduce_rank es = reduce_rank_iter es (Suc (length es))"

text \<open>
  Executable check of a rank candidate: every listed edge has to descend.
  Since the rank is generated by evaluation, this turns the rank certificate
  of a concrete table into a single computation.
\<close>

fun reduce_rank_check :: "(state \<times> state) list \<Rightarrow> (state \<Rightarrow> nat) \<Rightarrow> bool" where
  "reduce_rank_check [] r = True"
| "reduce_rank_check ((s, g) # es) r = (r g < r s \<and> reduce_rank_check es r)"

lemma reduce_rank_check_sound:
  "reduce_rank_check es r \<Longrightarrow> (s, g) \<in> set es \<Longrightarrow> r g < r s"
  by (induct es r rule: reduce_rank_check.induct) auto

lemma reduce_rank_check_complete:
  "(\<And>s g. (s, g) \<in> set es \<Longrightarrow> r g < r s) \<Longrightarrow> reduce_rank_check es r"
  by (induct es r rule: reduce_rank_check.induct) auto

text \<open>
  The generated rank as a certificate for the reduction graph.  The caller
  proves once that the edge list covers the graph; the strictly descending
  values then come from the check.
\<close>

theorem reduce_state_rank_certificate_auto:
  assumes edges: "reduce_graph t \<subseteq> set es"
    and check: "reduce_rank_check es (auto_reduce_rank es)"
  shows "reduce_state_rank_certificate t (auto_reduce_rank es)"
  unfolding reduce_state_rank_certificate_def
proof (intro allI impI)
  fix s g
  assume "(s, g) \<in> reduce_graph t"
  with edges have "(s, g) \<in> set es" by blast
  with check show "auto_reduce_rank es g < auto_reduce_rank es s"
    by (rule reduce_rank_check_sound)
qed

corollary reduce_graph_acyclic_auto:
  assumes edges: "reduce_graph t \<subseteq> set es"
    and check: "reduce_rank_check es (auto_reduce_rank es)"
  shows "acyclic (reduce_graph t)"
proof (rule acyclicI_order[where f = "auto_reduce_rank es"])
  fix s g
  assume "(s, g) \<in> reduce_graph t"
  with edges have "(s, g) \<in> set es" by blast
  with check show "auto_reduce_rank es g < auto_reduce_rank es s"
    by (rule reduce_rank_check_sound)
qed

theorem reduce_rank_certificate_auto:
  assumes edge_certificate: "reduce_graph_edge_certificate reachable t"
    and edges: "reduce_graph t \<subseteq> set es"
    and check: "reduce_rank_check es (auto_reduce_rank es)"
  shows "reduce_rank_certificate reachable
    (reduce_rank_of_state (auto_reduce_rank es)) t"
proof (rule reduce_graph_rank_certificate)
  show "reduce_graph_edge_certificate reachable t"
    by (rule edge_certificate)
next
  show "reduce_state_rank_certificate t (auto_reduce_rank es)"
    by (rule reduce_state_rank_certificate_auto[OF edges check])
qed

text \<open>
  The complete finite-execution certificate, with the rank generated from the
  edge list.  Compared with
  @{thm [source] finite_execution_certificate_of_reduce_graph}, the caller no
  longer provides a rank function or its certificate: it provides the edge
  list, a proof that the reduction graph is covered by it, and the decidable
  check of the generated rank.
\<close>

theorem finite_execution_certificate_of_reduce_graph_auto:
  assumes init_reachable: "reachable (init_config t toks)"
    and reachable_next:
      "\<And>cfg cfg'. reachable cfg \<Longrightarrow>
        one_step t cfg = Next cfg' \<Longrightarrow> reachable cfg'"
    and invariant_init: "input_invariant toks (init_config t toks)"
    and invariant_next:
      "\<And>cfg cfg'. input_invariant toks cfg \<Longrightarrow>
        one_step t cfg = Next cfg' \<Longrightarrow> input_invariant toks cfg'"
    and shift_bound:
      "\<And>cfg cfg'. reachable cfg \<Longrightarrow>
        shift_step t cfg cfg' \<Longrightarrow>
        position cfg < length (input_tokens cfg)"
    and reduce_correct: "reduce_transition_correct t"
    and reachable_source:
      "\<And>cfg. reachable cfg \<Longrightarrow> \<exists>toks. reachable_cfg t toks cfg"
    and edges: "reduce_graph t \<subseteq> set es"
    and check: "reduce_rank_check es (auto_reduce_rank es)"
  shows "finite_execution_certificate t toks reachable
    (reduce_rank_of_state (auto_reduce_rank es))"
  by (rule finite_execution_certificate_of_reduce_graph)
     (auto intro: init_reachable reachable_next invariant_init invariant_next
        shift_bound reduce_correct reachable_source
        reduce_state_rank_certificate_auto[OF edges check])

text \<open>
  Sanity checks of the executable formulation: on a chain of two edges the
  generator produces the height, and on a cycle it produces a value that the
  check rejects.  Both are proved by computing, not by reasoning.
\<close>

lemma auto_reduce_rank_chain: "auto_reduce_rank [(0, 1), (1, 2)] 0 = 3"
  by eval

lemma auto_reduce_rank_cycle:
  "\<not> reduce_rank_check [(0, 1), (1, 0)] (auto_reduce_rank [(0, 1), (1, 0)])"
  by eval

end
